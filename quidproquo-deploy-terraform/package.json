{
  "name": "quidproquo-deploy-terraform",
  "version": "0.0.263",
  "description": "Terraform deployment generator for quidproquo applications.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "sideEffects": false,
  "bin": {
    "qpq-terraform": "./bin/qpq-terraform.js"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "src/**/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:parity": "tsx src/test/parity/index.ts --cdk-out=examples/minimal-app/cdk.out --expected=src/test/parity/expected-diffs.json",
    "test:parity:baseline": "npm run test:parity -- --baseline=cdk",
    "clean": "npx rimraf lib && npx rimraf node_modules",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "watch": "tsc -p tsconfig.commonjs.json -w",
    "build:cjs": "tsc -p tsconfig.commonjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-coady/quidproquo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joe-coady/quidproquo/issues"
  },
  "homepage": "https://github.com/joe-coady/quidproquo#readme",
  "dependencies": {
    "quidproquo-config-aws": "0.0.263",
    "quidproquo-core": "0.0.263",
    "quidproquo-webserver": "0.0.263"
  },
  "devDependencies": {
    "@types/node": "^22.13.13",
    "quidproquo-tsconfig": "0.0.263",
    "typescript": "^5.8.2",
    "vitest": "^4.1.6"
  }
}
